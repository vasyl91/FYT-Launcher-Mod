<?xml version="1.0" encoding="utf-8"?>
<!--
    The wide inside of the music widget (bottom bar), used when the date or the weather of the
    widget bar is hidden and the music widget has their room. The text (title, artist) is between
    the cover and the buttons, and the buttons are a block on the right: 2 x 2 (30% of the widget,
    prev and next above play/pause and favorite) or one row of four (40%, in the compact bar). The
    ids are those of music_bar_content.xml. The sizes and the order of the cells are set in code
    by MusicWidgetSizer (the 0dp here are placeholders), so a change of the bar's height only
    changes the sizes and the order, never the views.
-->
<merge
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <ImageView
        android:id="@+id/iv_album_bg_two"
        android:tag="@string/skin_ruleless"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@drawable/music_album_def"
        android:adjustViewBounds="true"
        android:scaleType="fitCenter" />

    <LinearLayout
        android:id="@+id/music_bar_column"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">

        <TextView
            android:id="@+id/tv_musicName_two"
            android:textSize="0sp"
            android:textColor="@android:color/white"
            android:ellipsize="marquee"
            android:marqueeRepeatLimit="marquee_forever"
            android:gravity="center_horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/music_name"
            android:singleLine="true" />

        <TextView
            android:id="@+id/tv_artist_two"
            android:textSize="0sp"
            android:textColor="#aaffffff"
            android:ellipsize="marquee"
            android:marqueeRepeatLimit="marquee_forever"
            android:gravity="center_horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/music_author"
            android:singleLine="true" />

    </LinearLayout>

    <com.google.android.flexbox.FlexboxLayout
        android:id="@+id/music_bar_buttons"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        app:flexDirection="row"
        app:flexWrap="wrap"
        app:alignItems="center"
        app:alignContent="center"
        app:justifyContent="center">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/constraint_layout_prev_two"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_flexBasisPercent="50%">

            <Button
                android:id="@+id/music_prev_two"
                android:background="@drawable/btn_ic_prev"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/constraint_layout_playpause_two"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_flexBasisPercent="50%">

            <Button
                android:id="@+id/music_playpause_two"
                android:background="@drawable/music_pause_icon"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/constraint_layout_next_two"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_flexBasisPercent="50%">

            <Button
                android:id="@+id/music_next_two"
                android:background="@drawable/btn_ic_next"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/constraint_layout_favorite_two"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_flexBasisPercent="50%">

            <Button
                android:id="@+id/music_favorite_two"
                android:background="@drawable/btn_ic_favorite"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.flexbox.FlexboxLayout>
</merge>
