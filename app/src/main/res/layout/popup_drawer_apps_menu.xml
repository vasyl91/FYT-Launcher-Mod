<?xml version="1.0" encoding="utf-8"?>
<!-- The menu of the header of the lists of apps: "Show hidden apps" with a checkbox on the right, on the dark surface
     of the settings, its text and checkbox as those of the list (the owner, 2026-11-27; it was black on light). A tap
     anywhere on the row is the tap of the checkbox. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawer_menu_row"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="48dp"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="4dp"
    android:paddingEnd="8dp"
    android:paddingBottom="4dp">

    <TextView
        android:id="@+id/drawer_menu_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/show_hidden_apps"
        android:textAppearance="?android:attr/textAppearanceListItem"
        android:textColor="@color/white" />

    <CheckBox
        android:id="@+id/drawer_menu_check"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:clickable="false"
        android:focusable="false" />
</LinearLayout>
