<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/constraint_extra"
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" >

        <!-- The fields start after the longest label, whatever its language and size -->
        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/barrier_extra"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="end"
            app:constraint_referenced_ids="vehicle_mass_code_text,engine_displacement_code_text" />

        <!-- Title -->
        <TextView
            android:id="@+id/canbus_optional"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/canbus_optional"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Vehicle Mass Row -->
        <TextView
            android:id="@+id/vehicle_mass_code_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/vehicle_mass_code_text"
            app:layout_constraintTop_toBottomOf="@id/canbus_optional"
            app:layout_constraintStart_toStartOf="parent" />

        <EditText
            android:id="@+id/vehicle_mass_code_int"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:inputType="number"
            app:layout_constraintStart_toEndOf="@id/barrier_extra"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBaseline_toBaselineOf="@id/vehicle_mass_code_text" />

        <!-- Engine Displacement Row -->
        <TextView
            android:id="@+id/engine_displacement_code_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/engine_displacement_code_text"
            app:layout_constraintTop_toBottomOf="@id/vehicle_mass_code_text"
            app:layout_constraintStart_toStartOf="parent" />

        <EditText
            android:id="@+id/engine_displacement_code_int"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:inputType="number"
            app:layout_constraintStart_toEndOf="@id/barrier_extra"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBaseline_toBaselineOf="@id/engine_displacement_code_text" />

        <!-- Description -->
        <TextView
            android:id="@+id/canbus_optional_description"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/canbus_optional_description"
            app:layout_constraintTop_toBottomOf="@id/engine_displacement_code_text"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Where to find the values -->
        <TextView
            android:id="@+id/car_data_source"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/car_data_source"
            app:layout_constraintTop_toBottomOf="@id/canbus_optional_description"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
