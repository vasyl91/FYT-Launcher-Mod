<!-- Sizes of the texts and buttons come from RadioWidgetSizer (from the size of the widget). -->
<AbsoluteLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/absolute_radio"
    android:background="@drawable/bg_custom" >

    <LinearLayout
        android:id="@+id/rl_radio"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:gravity="center"
        android:orientation="horizontal" >

        <LinearLayout
            android:id="@+id/radio_col_left"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical" >

            <TextView
                android:id="@+id/tv_band"
                android:textSize="0sp"
                android:textColor="@android:color/white"
                android:gravity="center"
                android:maxLines="1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FM" />

            <Button
                android:id="@+id/radio_btn_prev"
                android:background="@drawable/btn_ic_prev"
                android:layout_width="0dp"
                android:layout_height="0dp" />

        </LinearLayout>

        <TextView
            android:id="@+id/tv_freq"
            android:textSize="0sp"
            android:textColor="@android:color/white"
            android:gravity="center"
            android:maxLines="1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="87.50" />

        <LinearLayout
            android:id="@+id/radio_col_right"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical" >

            <TextView
                android:id="@+id/tv_unit"
                android:textSize="0sp"
                android:textColor="@android:color/white"
                android:gravity="center"
                android:maxLines="1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="KHz" />

            <Button
                android:id="@+id/radio_btn_next"
                android:background="@drawable/btn_ic_next"
                android:layout_width="0dp"
                android:layout_height="0dp" />

        </LinearLayout>
    </LinearLayout>
</AbsoluteLayout>
