<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/constraint_codes"
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" >

        <!-- The fields start after the longest label, whatever its language and size -->
        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/barrier_codes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="end"
            app:constraint_referenced_ids="fuel_code_text,range_code_text,speed_code_text,rpm_code_text,cmdInt_code_text,cmdArr_code_text" />

        <!-- Title -->
        <TextView
            android:id="@+id/stats_dialog_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/stats_dialog_title"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Fuel Code Row -->
        <TextView
            android:id="@+id/fuel_code_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/fuel_code_text"
            app:layout_constraintTop_toBottomOf="@id/stats_dialog_title"
            app:layout_constraintStart_toStartOf="parent" />

        <EditText
            android:id="@+id/fuel_code_int"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            app:layout_constraintStart_toEndOf="@id/barrier_codes"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBaseline_toBaselineOf="@id/fuel_code_text" />

        <!-- Range Code Row -->
        <TextView
            android:id="@+id/range_code_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/range_code_text"
            app:layout_constraintTop_toBottomOf="@id/fuel_code_text"
            app:layout_constraintStart_toStartOf="parent" />

        <EditText
            android:id="@+id/range_code_int"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            app:layout_constraintStart_toEndOf="@id/barrier_codes"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBaseline_toBaselineOf="@id/range_code_text" />

        <!-- Speed Code Row: for the estimate where the car gives no consumption -->
        <TextView
            android:id="@+id/speed_code_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/speed_code_text"
            app:layout_constraintTop_toBottomOf="@id/range_code_text"
            app:layout_constraintStart_toStartOf="parent" />

        <EditText
            android:id="@+id/speed_code_int"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            app:layout_constraintStart_toEndOf="@id/barrier_codes"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBaseline_toBaselineOf="@id/speed_code_text" />

        <!-- RPM Code Row -->
        <TextView
            android:id="@+id/rpm_code_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/rpm_code_text"
            app:layout_constraintTop_toBottomOf="@id/speed_code_text"
            app:layout_constraintStart_toStartOf="parent" />

        <EditText
            android:id="@+id/rpm_code_int"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            app:layout_constraintStart_toEndOf="@id/barrier_codes"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBaseline_toBaselineOf="@id/rpm_code_text" />

        <!-- CMD Int Row -->
        <TextView
            android:id="@+id/cmdInt_code_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cmdInt_code_text"
            app:layout_constraintTop_toBottomOf="@id/rpm_code_text"
            app:layout_constraintStart_toStartOf="parent" />

        <EditText
            android:id="@+id/cmdInt_code_int"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            app:layout_constraintStart_toEndOf="@id/barrier_codes"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBaseline_toBaselineOf="@id/cmdInt_code_text" />

        <!-- CMD Arr Row -->
        <TextView
            android:id="@+id/cmdArr_code_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cmdArr_list_code_text"
            app:layout_constraintTop_toBottomOf="@id/cmdInt_code_text"
            app:layout_constraintStart_toStartOf="parent" />

        <EditText
            android:id="@+id/cmdArr_code_int"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            app:layout_constraintStart_toEndOf="@id/barrier_codes"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBaseline_toBaselineOf="@id/cmdArr_code_text" />

        <!-- The requests of the screens of this car, as the library knows them -->
        <TextView
            android:id="@+id/known_requests_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textIsSelectable="true"
            app:layout_constraintTop_toBottomOf="@id/cmdArr_code_text"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- What an empty field uses, and the codes the code reader found for this car -->
        <TextView
            android:id="@+id/codes_info_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textIsSelectable="true"
            app:layout_constraintTop_toBottomOf="@id/known_requests_text"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
