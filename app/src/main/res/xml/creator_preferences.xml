<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen  xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_height="match_parent"
    android:layout_width="match_parent"
    android:id="@+id/creator_preferences" >

    <!-- The grid of the pages and what else arranges the home screen. The two sliders keep nothing under
         their own keys: they set the cells along the long and the short edge of the screen
         (GridSeekBarPreference, WorkspaceGrid). -->
    <PreferenceCategory
        app:key="home_layout_category"
        app:title="@string/home_layout_category">

        <Preference
            android:key="workspace_grid_rows_title"
            android:title="@string/workspace_grid_rows"
            android:selectable="false" />
        <com.android.launcher66.settings.GridSeekBarPreference
            android:key="workspace_grid_rows" />
        <Preference
            android:key="workspace_grid_rows_note"
            android:summary="@string/workspace_grid_rows_note"
            android:selectable="false" />
        <Preference
            android:key="workspace_grid_columns_title"
            android:title="@string/workspace_grid_columns"
            android:selectable="false" />
        <com.android.launcher66.settings.GridSeekBarPreference
            android:key="workspace_grid_columns" />
        <Preference
            android:key="workspace_grid_columns_note"
            android:summary="@string/workspace_grid_columns_note"
            android:selectable="false" />
        <Preference
            android:key="start_page"
            android:title="@string/start_page"
            android:summary="1" />
        <Preference
            android:key="all_apps_textSize"
            android:title="@string/all_apps_textSize_str"
            android:summary="18" />
        <Preference
            android:key="workspace_textSize"
            android:title="@string/workspace_textSize_str"
            android:summary="28" />

    </PreferenceCategory>

    <Preference
        android:layout="@layout/preference_separator"
        android:selectable="false" />

    <PreferenceCategory
        app:key="widgets_category"
        app:title="@string/widgets_category">

        <SwitchPreferenceCompat
            app:singleLineTitle="false"
            android:key="display_pip"
            android:title="@string/display_pip"
            android:defaultValue="true" />
        <com.android.launcher66.settings.CustomDualPipPreference
            app:key="pip_dual"
            app:title="@string/pref_dual_pip_title"
            app:defaultValue="false"
            app:summary="@string/pref_dual_pip_summary" />
        <com.android.launcher66.settings.CustomPipSwitchPreference
            app:key="pip_first"
            app:title="@string/pref_first_pip_title"
            app:defaultValue="false"
            app:summary="@string/pref_no_app_selected" />
        <com.android.launcher66.settings.CustomPipSwitchPreference
            app:key="pip_second"
            app:title="@string/pref_second_pip_title"
            app:defaultValue="false"
            app:summary="@string/pref_no_app_selected" />
        <com.android.launcher66.settings.CustomPipSwitchPreference
            app:key="pip_third"
            app:title="@string/pref_third_pip_title"
            app:defaultValue="false"
            app:summary="@string/pref_no_app_selected" />   
        <com.android.launcher66.settings.CustomPipSwitchPreference
            app:key="pip_fourth"
            app:title="@string/pref_fourth_pip_title"
            app:defaultValue="false"
            app:summary="@string/pref_no_app_selected" />  
        <com.android.launcher66.settings.CustomPipRestartPreference 
            android:key="restart_pip"
            android:title="@string/restart_pip"
            app:summary="@string/restart_pip_summary" />
        <com.android.launcher66.settings.CustomSwitchPreference
            android:key="fab_overlay_button"
            android:defaultValue="false"
            android:title="@string/fab_overlay_button"
            app:summary="@string/fab_overlay_controls_summary"
            app:layout="@layout/nested_preference_category_switch" />
        <com.android.launcher66.settings.CustomSwitchPreference
            android:key="fab_overlay_button_left"
            android:defaultValue="false"
            android:title="@string/fab_overlay_button_left"
            app:summary="@string/fab_overlay_controls_summary"
            app:layout="@layout/nested_preference_category_switch" />
        <com.android.launcher66.settings.CustomSwitchPreference
            android:key="fab_overlay_button_right"
            android:defaultValue="false"
            android:title="@string/fab_overlay_button_right"
            app:summary="@string/fab_overlay_controls_summary"
            app:layout="@layout/nested_preference_category_switch" />
        <com.android.launcher66.settings.CustomSwitchPreference
            android:key="extended_divider"
            android:defaultValue="true"
            android:title="@string/extended_divider"
            android:summary=" "
            app:layout="@layout/nested_preference_category_switch" />
        <com.android.launcher66.settings.CustomNestedThreePreference
            android:key="cover_splash_mode"
            android:defaultValue="icon"
            android:title="@string/cover_splash"
            android:entries="@array/cover_splash_entries"
            android:entryValues="@array/cover_splash_values"
            app:layout="@layout/nested_preference_category_no_switch" />
        <com.android.launcher66.settings.CustomSwitchPreference
            android:key="swipe_detector"
            android:defaultValue="false"
            android:title="@string/swipe_detector"
            app:summary="@string/swipe_detector_summary"
            app:layout="@layout/nested_preference_category_switch" />
        <com.android.launcher66.settings.CustomWidgetSwitchPreference
            android:key="user_date"
            android:defaultValue="true"
            android:title="@string/date_widget"
            app:summary="@string/adjust_widget" />
        <com.android.launcher66.settings.CustomWidgetSwitchPreference
            android:key="user_music"
            android:defaultValue="true"
            android:title="@string/music_widget"
            app:summary="@string/adjust_widget" />
        <com.android.launcher66.settings.CustomWidgetSwitchPreference
            android:key="user_radio"
            android:defaultValue="true"
            android:title="@string/radio_widget"
            app:summary="@string/adjust_widget" />
        <Preference
            android:key="choose_widgets_background"
            android:title="@string/widgets_background_preference"/>
        <!-- Opens the colour picker (text mode); the colour is stored under widgets_tint_color -->
        <Preference
            android:key="choose_widgets_tint"
            android:persistent="false"
            android:title="@string/black_widgets"/>
        <Preference
            android:key="layout_margin"
            android:title="@string/margins_str"
            android:summary="10" />

    </PreferenceCategory>

    <Preference
        android:layout="@layout/preference_separator"
        android:selectable="false" />

    <PreferenceCategory
        app:key="bars_category"
        app:title="@string/bars_category">

        <com.android.launcher66.settings.CustomNoSwitchPreference
            android:key="horizontal_bar_top"
            android:defaultValue="false"
            android:title="@string/horizontal_bar_position"
            android:summaryOn="@string/horizontal_bar_position_top"
            android:summaryOff="@string/horizontal_bar_position_bottom"
            app:layout="@layout/preference_no_switch" />
        <SwitchPreferenceCompat
            app:singleLineTitle="false"
            android:key="bottom_bar_every_page"
            android:defaultValue="false"
            android:title="@string/horizontal_bar_every_page"
            android:summaryOn="@string/horizontal_bar_every_page_on"
            android:summaryOff="@string/horizontal_bar_every_page_off" />
        <SwitchPreferenceCompat
            app:singleLineTitle="false"
            android:key="auto_hide_bottom_bar"
            android:defaultValue="false"
            android:title="@string/auto_hide_horizontal_bar"
            android:summaryOn="@string/auto_hide_timeout" />     
        <com.android.launcher66.settings.AutoHideSeekBarPreference
            android:key="auto_hide_timeout"
            android:defaultValue="5" /> 
        <com.android.launcher66.settings.CustomNoSwitchPreference
            android:key="edge_handle_right"
            android:defaultValue="false"
            android:title="@string/edge_handle_side"
            android:summaryOn="@string/edge_handle_side_right"
            android:summaryOff="@string/edge_handle_side_left"
            app:layout="@layout/preference_no_switch" />
        <SwitchPreferenceCompat
            app:singleLineTitle="false"
            android:key="resizable_bottom_bar"
            android:defaultValue="false"
            android:title="@string/resizable_horizontal_bar"
            android:summaryOn="@string/resizable_horizontal_bar_summary" />
        <!-- Stores its value under bottom_bar_height_port / bottom_bar_height_land
             (per orientation), never under its own key. -->
        <com.android.launcher66.settings.HorizontalBarHeightSeekBarPreference
            android:key="bottom_bar_height"
            android:persistent="false" />
        <Preference
            android:key="choose_bar_background"
            android:title="@string/bar_background_preference"/>  
        <!-- Opens the colour picker (text mode); the colour is stored under bar_tint_color -->
        <Preference
            android:key="choose_bar_tint"
            android:persistent="false"
            android:title="@string/black_bar"/>
        <SwitchPreferenceCompat
            app:singleLineTitle="false"
            android:key="widget_bar"
            android:defaultValue="false"
            android:title="@string/widget_bar" />
        <com.android.launcher66.settings.CustomSwitchPreference
            android:key="widget_bar_no_cover"
            android:defaultValue="false"
            android:title="@string/widget_bar_no_cover"
            android:summaryOn="@string/widget_bar_no_cover_on"
            app:layout="@layout/nested_preference_category_switch" />
        <com.android.launcher66.settings.CustomSwitchPreference
            android:key="widget_bar_no_date"
            android:defaultValue="false"
            android:title="@string/widget_bar_no_date"
            android:summaryOn="@string/widget_bar_hidden_on"
            app:layout="@layout/nested_preference_category_switch" />
        <com.android.launcher66.settings.CustomSwitchPreference
            android:key="widget_bar_no_weather"
            android:defaultValue="false"
            android:title="@string/widget_bar_no_weather"
            android:summaryOn="@string/widget_bar_hidden_on"
            app:layout="@layout/nested_preference_category_switch" />
        <com.android.launcher66.settings.CustomSwitchPreference
            android:key="widget_bar_buttons_beside"
            android:defaultValue="true"
            android:title="@string/widget_bar_buttons_beside"
            android:summaryOn="@string/widget_bar_buttons_beside_on"
            android:summaryOff="@string/widget_bar_buttons_beside_off"
            app:layout="@layout/nested_preference_category_switch" />
        <com.android.launcher66.settings.CustomSwitchPreference
            android:key="widget_bar_buttons_one_line"
            android:defaultValue="false"
            android:title="@string/widget_bar_buttons_one_line"
            android:summaryOn="@string/widget_bar_buttons_one_line_on"
            android:summaryOff="@string/widget_bar_buttons_one_line_off"
            app:layout="@layout/nested_preference_category_switch" />
        <com.android.launcher66.settings.CustomNestedThreePreference
            android:key="widget_bar_line_mode"
            android:defaultValue="two"
            android:title="@string/widget_bar_line_mode"
            android:entries="@array/widget_bar_line_mode_entries"
            android:entryValues="@array/widget_bar_line_mode_values"
            app:layout="@layout/nested_preference_category_no_switch" />
        <com.android.launcher66.settings.CustomSwitchPreference
            android:key="widget_bar_large_text"
            android:defaultValue="false"
            android:title="@string/widget_bar_large_text"
            android:summaryOn="@string/widget_bar_large_text_on"
            android:summaryOff="@string/widget_bar_large_text_off"
            app:layout="@layout/nested_preference_category_switch" />
        <SwitchPreferenceCompat
            app:singleLineTitle="false"
            android:key="left_bar"
            android:defaultValue="false"
            android:title="@string/vertical_bar"
            android:summaryOn="@string/vertical_bar_on"
            android:summaryOff="@string/vertical_bar_off" />
        <com.android.launcher66.settings.CustomNoSwitchPreference
            android:key="vertical_bar_right"
            android:defaultValue="false"
            android:title="@string/vertical_bar_side"
            android:summaryOn="@string/vertical_bar_side_right"
            android:summaryOff="@string/vertical_bar_side_left"
            app:layout="@layout/preference_no_switch" />
        <SwitchPreferenceCompat
            app:singleLineTitle="false"
            android:key="vertical_bar_every_page"
            android:defaultValue="false"
            android:title="@string/vertical_bar_every_page"
            android:summaryOn="@string/horizontal_bar_every_page_on"
            android:summaryOff="@string/horizontal_bar_every_page_off" />
        <Preference
            android:key="choose_vertical_bar_background"
            android:title="@string/vertical_bar_background_preference" />

    </PreferenceCategory>

    <Preference
        android:layout="@layout/preference_separator"
        android:selectable="false" />

    <PreferenceCategory
        app:key="stats_category"
        app:title="@string/stats_category" >

        <SwitchPreferenceCompat
            app:singleLineTitle="false"
            android:key="user_stats"
            android:defaultValue="false"
            android:title="@string/stats_window"
            android:maxLines="5" />  
        <com.android.launcher66.settings.CustomWidgetPreference
            android:key="stats_display"
            android:title="@string/stats_screen_summary"
            app:summary="@string/stats_resize" />   
        <Preference
            android:key="stats_codes"
            android:title="@string/stats_codes"
            android:maxLines="5" />     
        <Preference
            android:key="extra_stats_codes"
            android:title="@string/extra_stats_codes"
            android:maxLines="5" />
        <SwitchPreferenceCompat
            app:singleLineTitle="false"
            android:key="main_screen_stats"
            android:defaultValue="true"
            android:title="@string/main_screen_stats_window" />
        <!-- The background and the text colour of the statistics window, chosen as the widgets' are: the
             selector with the pictures, no background and the user's own colour, and the colour picker -->
        <Preference
            android:key="choose_stats_background"
            android:persistent="false"
            android:title="@string/stats_background_preference" />
        <Preference
            android:key="color_picker"
            android:persistent="false"
            android:title="@string/color_picker" />
        <Preference
            android:key="app_list"
            android:title="@string/app_list_stats"
            android:summary="@string/app_list_stats_summary"  />
        <Preference
            android:key="app_stats_coordinates"
            android:title="@string/stats_coordinates_string"
            app:summary="@string/stats_resize" />   

    </PreferenceCategory>

    <Preference
        android:layout="@layout/preference_separator"
        android:selectable="false" />

    <PreferenceCategory
        app:key="canbus_reader"
        app:title="@string/canbus_reader_category" >

        <SwitchPreferenceCompat
            app:singleLineTitle="false"
            android:key="display_canbus_reader"
            android:defaultValue="false"
            android:title="@string/display_canbus_reader" />     
        <Preference
            android:key="codes_guide"
            android:title="@string/codes_guide"  />
        <Preference
            android:key="skip_codes"
            android:title="@string/skip_codes"
            android:maxLines="5"  />
        <Preference
            android:key="canbus_library_import"
            android:title="@string/canbus_library_import"
            android:maxLines="5" />
        <Preference
            android:key="canbus_library_export"
            android:title="@string/canbus_library_export"
            android:summary="@string/canbus_library_export_summary"
            android:maxLines="5" />
        <Preference
            android:key="canbus_library_reset"
            android:title="@string/canbus_library_reset"
            android:maxLines="5" />

        <com.android.launcher66.settings.CustomPreferenceCategory
            app:key="inspector_category"
            app:title="@string/inspector_category"
            style="@style/PreferenceCategoryStyle" >

            <com.android.launcher66.settings.CustomPreference
                android:key="code_inspector"
                android:title="@string/code_inspector_string"
                app:layout="@layout/nested_preference_category_content"  />        
            <com.android.launcher66.settings.CustomPreference
                android:key="code_inspector_data"
                android:title="@string/code_inspector_data"
                android:maxLines="5"
                app:layout="@layout/nested_preference_category_content" />
            <com.android.launcher66.settings.CustomSwitchPreference
                android:key="skip_zero_codes"
                android:defaultValue="true"
                android:title="@string/skip_zero_codes"
                app:summary="@string/skip_zero_codes_summary"
                app:layout="@layout/nested_preference_category_switch" />
            
        </com.android.launcher66.settings.CustomPreferenceCategory>
        <Preference
            android:key="empty"
            android:focusable="false"
            android:clickable="false" />

    </PreferenceCategory>

    <Preference
        android:layout="@layout/preference_separator"
        android:selectable="false" />

</PreferenceScreen>