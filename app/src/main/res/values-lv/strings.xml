    <string name="stats_codes_empty_fields">Tukšs lauks izmanto canbus bibliotēkas kodu (degviela, nobraukums) vai canbus lasītāja kodu (ātrums; bez tā — GPS). Jūsu ievadītais kods vienmēr ir svarīgāks. Ātrums un apgriezieni nav obligāti: ātrums uzlabo patēriņa novērtējumu, ja auto to nerāda.</string>
    <string name="stats_codes_pairs_line">Bibliotēka: %1$s — lietošanā: %2$s (%3$s)</string>
    <string name="stats_codes_pair_confirmed">apstiprināts</string>
