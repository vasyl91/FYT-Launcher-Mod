<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">  

    <!-- Left Bar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/rl_left_bar"
        android:background="@drawable/hotseat_bg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="W,0.071"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/iv_list_bg"
        app:layout_constraintLeft_toLeftOf="parent">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/left_recycler_view"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Workspace -->
    <AbsoluteLayout
        android:id="@+id/user_layout_left"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Bottom Bar -->
    <ImageView
        android:id="@+id/iv_list_bg"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="H,0.142"
        app:layout_constraintBottom_toBottomOf="parent"
        android:scaleType="fitXY"
        android:src="@drawable/app_list_bg" />
        
    <ImageView
        android:id="@+id/rl_allapps"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintHeight_percent="0.11"
        app:layout_constraintWidth_percent="0.10"
        app:layout_constraintBottom_toBottomOf="@id/iv_list_bg"
        app:layout_constraintTop_toTopOf="@id/iv_list_bg"
        app:layout_constraintVertical_bias="0.5"
        app:layout_constraintLeft_toLeftOf="parent"
        android:src="@drawable/all_apps_btn_icon" />

    <ImageView
        android:id="@+id/show_bar"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintHeight_percent="0.11"
        app:layout_constraintWidth_percent="0.06"
        app:layout_constraintBottom_toBottomOf="@+id/iv_list_bg"
        app:layout_constraintTop_toTopOf="@+id/iv_list_bg"
        app:layout_constraintVertical_bias="0.5"
        app:layout_constraintStart_toStartOf="@+id/iv_list_bg"
        app:layout_constraintEnd_toEndOf="@+id/iv_list_bg"
        android:src="@drawable/show_bar"
        android:scaleType="fitCenter"
        android:visibility="invisible" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="H,0.295"
        app:layout_constraintWidth_percent="0.4385"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="@id/iv_list_bg"
        app:layout_constraintRight_toLeftOf="@id/rl_music_two"
        app:layout_constraintLeft_toRightOf="@id/rl_allapps" />

    <!-- Bottom Bar Music -->
    <LinearLayout
        android:id="@+id/rl_music_two"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="H,0.45"
        app:layout_constraintWidth_percent="0.295"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="@id/iv_list_bg"
        app:layout_constraintRight_toLeftOf="@id/bar_widget_weather"
        app:layout_constraintLeft_toRightOf="@id/recycler_view"
        android:orientation="horizontal"
        android:gravity="center_vertical" >

        <include layout="@layout/music_bar_content" />
    </LinearLayout>

    <!-- Bottom Bar Weather -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bar_widget_weather"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="H,0.95"
        app:layout_constraintWidth_percent="0.15"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="@id/iv_list_bg"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintLeft_toRightOf="@id/rl_music_two" >

        <ImageView
            android:id="@+id/weather_imge1"
            android:src="@drawable/weather02d"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintHeight_percent="0.4"
            app:layout_constraintWidth_percent="1.0"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@id/weather_weather1"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent" />    

        <TextView
            android:id="@+id/weather_weather1"
            android:textSize="0sp"
            android:textColor="@android:color/white"
            android:ellipsize="marquee"
            android:marqueeRepeatLimit="marquee_forever"
            android:gravity="center_horizontal"
            android:text="@string/weather_not_available"
            android:singleLine="true"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintHeight_percent="0.25"
            app:layout_constraintWidth_percent="1.0"
            app:layout_constraintTop_toBottomOf="@id/weather_imge1"
            app:layout_constraintBottom_toTopOf="@id/weather_city1"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent" />    

        <TextView
            android:id="@+id/weather_city1"
            android:textSize="0sp"
            android:textColor="@android:color/white"
            android:ellipsize="marquee"
            android:marqueeRepeatLimit="marquee_forever"
            android:gravity="center_horizontal"
            android:text="@string/weather_not_available"
            android:singleLine="true"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintHeight_percent="0.25"
            app:layout_constraintWidth_percent="0.7"
            app:layout_constraintTop_toBottomOf="@id/weather_weather1"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toLeftOf="@id/weather_temp1" />

        <TextView
            android:id="@+id/weather_temp1"
            android:textSize="0sp"
            android:textColor="@android:color/white"
            android:ellipsize="marquee"
            android:marqueeRepeatLimit="marquee_forever"
            android:gravity="center_horizontal"
            android:text="@string/weather_not_available"
            android:singleLine="true"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintHeight_percent="0.25"
            app:layout_constraintWidth_percent="0.3"
            app:layout_constraintTop_toBottomOf="@id/weather_weather1"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toRightOf="@id/weather_city1"
            app:layout_constraintRight_toRightOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
